---
import Base from '../layouts/Base.astro';
import { CONTACT_HREF } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const title = 'Pricing — Affordable Server Monitoring | Lookout';
const description =
  'Simple, affordable per-server pricing for Lookout — from $4/server/mo. Starter, Pro, and Enterprise plans for managed or on-prem infrastructure monitoring. A budget-friendly Datadog alternative.';

const tiers = [
  {
    name: 'Starter',
    price: '$4',
    unit: '/server/mo',
    sub: 'Small teams getting started',
    features: ['Up to 25 servers', 'Hosted dashboard', 'Plain-English health', 'Email alerts', 'Nagios-compatible plugins', 'Email support'],
    cta: 'Get started',
    href: `${CONTACT_HREF}?plan=Starter`,
    featured: false,
  },
  {
    name: 'Pro',
    price: '$9',
    unit: '/server/mo',
    sub: 'Growing fleets',
    features: ['Up to 250 servers', 'Everything in Starter', 'Slack & webhook integrations', 'Alert escalation & dedup', 'Longer metric retention', 'API access', 'SSO + MFA', 'Priority support'],
    cta: 'Get started',
    href: `${CONTACT_HREF}?plan=Pro`,
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    unit: '',
    sub: 'Large or regulated fleets',
    features: ['Unlimited servers', 'Managed or on-prem deployment', 'SSO + SCIM + RBAC', 'Audit log & compliance evidence', 'Data residency / BYOK', 'SLA, onboarding & dedicated support'],
    cta: 'Contact sales',
    href: `${CONTACT_HREF}?plan=Enterprise`,
    featured: false,
  },
];
// Side-by-side feature matrix. Cells: true = included (◆), false = not (—), or a string for values.
const compareCols = ['Starter', 'Pro', 'Enterprise'];
const compareRows = [
  { feature: 'Servers monitored', cells: ['Up to 25', 'Up to 250', 'Unlimited'] },
  { feature: 'Full monitoring engine & checks', cells: [true, true, true] },
  { feature: 'Hosted dashboard', cells: [true, true, true] },
  { feature: 'Plain-English health', cells: [true, true, true] },
  { feature: 'Nagios-compatible plugins', cells: [true, true, true] },
  { feature: 'Email alerts', cells: [true, true, true] },
  { feature: 'Slack & webhook integrations', cells: [false, true, true] },
  { feature: 'Alert escalation & dedup', cells: [false, true, true] },
  { feature: 'Longer metric retention', cells: [false, true, true] },
  { feature: 'API access', cells: [false, true, true] },
  { feature: 'SSO + MFA', cells: [false, true, true] },
  { feature: 'SCIM provisioning + RBAC', cells: [false, false, true] },
  { feature: 'Audit log & compliance evidence', cells: [false, false, true] },
  { feature: 'Managed or on-prem deployment', cells: ['Managed', 'Managed', 'Managed or on-prem'] },
  { feature: 'Data residency / BYOK', cells: [false, false, true] },
  { feature: 'Support', cells: ['Email', 'Priority', 'SLA + dedicated'] },
  { feature: 'Onboarding & SLA', cells: [false, false, true] },
];
const faqs = [
  { q: 'How is Lookout priced?', a: 'By the number of servers (agents) you monitor, billed monthly. Starter and Pro are flat per-server rates; Enterprise is a custom quote that covers volume, on-prem deployment, and compliance needs.' },
  { q: 'What counts as a “server”?', a: 'Any server or VM you install the Lookout agent on. You only pay for hosts that are actively reporting.' },
  { q: 'Can I deploy Lookout on-prem?', a: 'Yes. On-prem deployment — running the control plane inside your own network — is available on the Enterprise plan, so your data never leaves your infrastructure. Talk to sales to scope it.' },
  { q: 'Is there a free tier?', a: 'No. Lookout is a commercial product. Starter is our entry plan; reach out if you’d like to trial it before committing.' },
  { q: 'Do cheaper plans lose features?', a: 'Every plan includes the full monitoring engine — all checks, plugins, the dashboard, and core alerting. Higher plans add scale, advanced alert routing, SSO/RBAC, and deployment options.' },
  { q: 'Do you offer MSP / partner pricing?', a: 'Yes. If you monitor fleets across multiple client organizations, we offer volume pricing and an optional white-label. Mention your client count when you contact sales.' },
];
---

<Base title={title} description={description}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-10 text-center">
    <h1 class="text-balance text-4xl font-black tracking-tight text-white md:text-5xl">Simple per-server pricing.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-400">Every plan includes the full monitoring engine. Pay only for the servers you watch. Prices shown are per server, per month, billed annually.</p>
  </section>

  <section class="mx-auto max-w-6xl px-6">
    <div class="mt-2 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {tiers.map((t) => (
        <div class={`relative rounded-2xl border p-6 ${t.featured ? 'border-indigo-400/50 bg-slate-900/80 shadow-xl shadow-indigo-500/10' : 'border-white/10 bg-slate-900/40'}`}>
          {t.featured && <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-indigo-500 to-fuchsia-500 px-3 py-1 text-xs font-bold text-white">Most popular</span>}
          <h3 class="text-lg font-bold text-white">{t.name}</h3>
          <p class="text-sm text-slate-500">{t.sub}</p>
          <div class="mt-4"><span class="text-3xl font-black text-white">{t.price}</span><span class="text-slate-400">{t.unit}</span></div>
          <ul class="mt-5 space-y-2 text-sm text-slate-300">
            {t.features.map((f) => <li class="flex gap-2"><span class="text-emerald-400" aria-hidden="true">◆</span>{f}</li>)}
          </ul>
          <a href={t.href} class={`mt-6 block rounded-lg px-4 py-2.5 text-center text-sm font-semibold transition ${t.featured ? 'bg-gradient-to-r from-indigo-500 to-fuchsia-500 text-white hover:opacity-90' : 'bg-white/10 text-white ring-1 ring-white/15 hover:bg-white/15'}`}>{t.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Compare plans -->
  <section id="compare" class="mx-auto max-w-6xl px-6 pt-16">
    <h2 class="text-center text-2xl font-black text-white">Compare plans</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-400">Every plan ships the full monitoring engine. The tiers differ in scale, alert routing, access controls, and how you deploy.</p>
    <div class="mt-8 overflow-x-auto rounded-2xl border border-white/10 bg-slate-900/40">
      <table class="w-full min-w-[40rem] border-collapse text-sm">
        <thead>
          <tr class="border-b border-white/10 text-left">
            <th class="px-5 py-4 font-semibold text-slate-300">Feature</th>
            {compareCols.map((c) => (
              <th class="px-5 py-4 text-center font-bold text-white">{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {compareRows.map((row) => (
            <tr class="border-b border-white/5 last:border-b-0">
              <td class="px-5 py-3 text-slate-300">{row.feature}</td>
              {row.cells.map((cell) => (
                <td class="px-5 py-3 text-center">
                  {cell === true
                    ? <span class="text-emerald-400" title="Included" aria-label="Included">◆</span>
                    : cell === false
                      ? <span class="text-slate-600" title="Not included" aria-label="Not included">—</span>
                      : <span class="text-slate-300">{cell}</span>}
                </td>
              ))}
            </tr>
          ))}
          <tr>
            <td class="px-5 py-4"></td>
            {tiers.map((t) => (
              <td class="px-5 py-4 text-center">
                <a href={t.href} class={`inline-block rounded-lg px-4 py-2 text-xs font-semibold transition ${t.featured ? 'bg-gradient-to-r from-indigo-500 to-fuchsia-500 text-white hover:opacity-90' : 'bg-white/10 text-white ring-1 ring-white/15 hover:bg-white/15'}`}>{t.cta}</a>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- MSP -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-8 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-indigo-300">For consultants & MSPs</p>
      <h2 class="mt-2 text-2xl font-black text-white">Monitor many clients from one console.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-400">Priced per managed client organization, with volume discounts — and the more clients you run, the lower the rate on every one. White-label available.</p>
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">$79</div><div class="text-xs font-semibold text-indigo-300">per client/mo</div><p class="mt-1 text-xs text-slate-500">1–10 clients</p></div>
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">$59</div><div class="text-xs font-semibold text-indigo-300">per client/mo</div><p class="mt-1 text-xs text-slate-500">11–50 clients</p></div>
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">$39</div><div class="text-xs font-semibold text-indigo-300">per client/mo</div><p class="mt-1 text-xs text-slate-500">51+ clients</p></div>
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">+$499</div><div class="text-xs font-semibold text-indigo-300">per mo</div><p class="mt-1 text-xs text-slate-500">white-label</p></div>
      </div>
      <a href={CONTACT_HREF} class="mt-8 inline-block rounded-xl bg-white/10 px-6 py-3 font-semibold text-white ring-1 ring-white/15 transition hover:bg-white/15">Talk to sales</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-6 pb-24">
    <h2 class="text-center text-2xl font-black text-white">Pricing questions</h2>
    <div class="mt-8 space-y-4">
      {faqs.map((f) => (
        <div class="rounded-xl border border-white/10 bg-slate-900/40 p-6">
          <h3 class="font-bold text-white">{f.q}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.a}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href={CONTACT_HREF} class="rounded-xl bg-gradient-to-r from-indigo-500 to-fuchsia-500 px-6 py-3 font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:opacity-90">Contact sales</a>
    </div>
  </section>
</Base>
