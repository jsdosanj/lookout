---
import Base from '../layouts/Base.astro';
import { GITHUB_URL } from '../consts';
const title = 'Pricing — Lookout';
const description =
  'Lookout is open source: self-host unlimited servers for free. Managed hosting from $29/mo, priced by how many hosts you monitor. MSP partner pricing available.';

const tiers = [
  { name: 'Starter', price: '$29', unit: '/mo', sub: 'Small teams', features: ['Up to 10 hosts', 'Hosted dashboard', 'Alerts (email/Slack)', 'MFA', 'Email support'], cta: 'Start', featured: false },
  { name: 'Team', price: '$99', unit: '/mo', sub: 'Growing fleets', features: ['Up to 50 hosts', 'Everything in Starter', 'Integrations & webhooks', 'API access', 'Priority support'], cta: 'Start', featured: true },
  { name: 'Business', price: '$299', unit: '/mo', sub: 'Mid-market', features: ['Up to 200 hosts', 'SSO + SCIM', 'Granular RBAC + audit log', 'SLA & onboarding'], cta: 'Contact us', featured: false },
  { name: 'Enterprise', price: 'Custom', unit: '', sub: '500+ / regulated', features: ['Unlimited hosts', 'Data residency / BYOK', 'Compliance evidence pack', 'Dedicated support'], cta: 'Talk to us', featured: false },
];
const faqs = [
  { q: 'Is self-hosting really free?', a: 'Yes. Lookout is open source under AGPL-3.0 — run the agent and the control plane on your own infrastructure, for unlimited hosts, at no cost, forever. You only pay if you want us to host and manage it for you.' },
  { q: 'What counts as a “host”?', a: 'Any server (or VM) you run the agent on. Hosted plans are priced by the number of hosts you monitor; self-hosting has no limit.' },
  { q: 'Do cheaper plans lose features?', a: 'Every plan — including free self-hosting — includes all checks, plugins, the dashboard, and alerts. Higher hosted plans add scale, SSO/RBAC, and support.' },
  { q: 'Do you offer MSP / partner pricing?', a: 'Yes. If you monitor fleets for multiple clients, we price per managed client organization with volume discounts, plus an optional white-label. Mention your client count when you contact us.' },
];
---

<Base title={title} description={description}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-10 text-center">
    <h1 class="text-balance text-4xl font-black tracking-tight text-white md:text-5xl">Open source. Self-host free — or let us run it.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-400">Every plan includes every feature. Hosted plans are priced by how many hosts you watch. Annual billing saves ~20%.</p>
  </section>

  <section class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center justify-between gap-6 rounded-2xl border border-indigo-400/30 bg-gradient-to-r from-indigo-500/10 to-fuchsia-500/10 p-8 md:flex-row">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-indigo-300">Self-Hosted · Open source</p>
        <h2 class="mt-2 text-2xl font-black text-white">Run it yourself — free, forever.</h2>
        <p class="mt-2 max-w-xl text-slate-400">Unlimited hosts, every feature, your infrastructure. Community support. AGPL-3.0.</p>
      </div>
      <div class="text-center">
        <div class="text-4xl font-black text-white">$0</div>
        <a href={GITHUB_URL} class="mt-3 inline-block rounded-xl bg-white px-6 py-3 font-semibold text-slate-900 transition hover:bg-slate-200">Get it on GitHub</a>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {tiers.map((t) => (
        <div class={`relative rounded-2xl border p-6 ${t.featured ? 'border-indigo-400/50 bg-slate-900/80 shadow-xl shadow-indigo-500/10' : 'border-white/10 bg-slate-900/40'}`}>
          {t.featured && <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-indigo-500 to-fuchsia-500 px-3 py-1 text-xs font-bold text-white">Most popular</span>}
          <h3 class="text-lg font-bold text-white">{t.name}</h3>
          <p class="text-sm text-slate-500">{t.sub}</p>
          <div class="mt-4"><span class="text-3xl font-black text-white">{t.price}</span><span class="text-slate-400">{t.unit}</span></div>
          <ul class="mt-5 space-y-2 text-sm text-slate-300">
            {t.features.map((f) => <li class="flex gap-2"><span class="text-emerald-400">✓</span>{f}</li>)}
          </ul>
          <a href={GITHUB_URL} class={`mt-6 block rounded-lg px-4 py-2.5 text-center text-sm font-semibold transition ${t.featured ? 'bg-gradient-to-r from-indigo-500 to-fuchsia-500 text-white hover:opacity-90' : 'bg-white/10 text-white ring-1 ring-white/15 hover:bg-white/15'}`}>{t.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <!-- MSP -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-8 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-indigo-300">For consultants & MSPs</p>
      <h2 class="mt-2 text-2xl font-black text-white">Monitor many clients from one console.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-400">Priced per managed client organization, with volume discounts — and the more clients you run, the lower the rate on every one.</p>
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">$79</div><div class="text-xs font-semibold text-indigo-300">per client/mo</div><p class="mt-1 text-xs text-slate-500">1–10 clients</p></div>
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">$59</div><div class="text-xs font-semibold text-indigo-300">per client/mo</div><p class="mt-1 text-xs text-slate-500">11–50 clients</p></div>
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">$39</div><div class="text-xs font-semibold text-indigo-300">per client/mo</div><p class="mt-1 text-xs text-slate-500">51+ clients</p></div>
        <div class="rounded-xl border border-white/10 bg-slate-900/50 p-5"><div class="text-2xl font-black text-white">+$499</div><div class="text-xs font-semibold text-indigo-300">per mo</div><p class="mt-1 text-xs text-slate-500">white-label</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-6 pb-24">
    <h2 class="text-center text-2xl font-black text-white">Pricing questions</h2>
    <div class="mt-8 space-y-4">
      {faqs.map((f) => (
        <div class="rounded-xl border border-white/10 bg-slate-900/40 p-6">
          <h3 class="font-bold text-white">{f.q}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.a}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
