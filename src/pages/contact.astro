---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const title = 'Contact Sales — Lookout Server Monitoring';
const description =
  'Get in touch with the Lookout team about managed plans, on-prem deployment, security, or pricing for our server and infrastructure monitoring. Send us a message and a human will reply.';
---

<Base title={title} description={description}>
  <section class="relative overflow-hidden grid-texture">
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full bg-gradient-to-br from-indigo-600/30 via-fuchsia-600/20 to-cyan-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-3xl px-6 pt-20 pb-12 md:pt-28">
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-indigo-300">● We usually reply within a day</span>
        <h1 class="mt-6 text-balance text-4xl font-black leading-tight tracking-tight text-white md:text-5xl">
          Let's <span class="bg-gradient-to-r from-indigo-400 via-fuchsia-400 to-cyan-300 bg-clip-text text-transparent">talk.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-pretty text-lg text-slate-300">
          Questions about managed plans, on-prem deployment, security, or pricing? Drop us a line and a human will get back to you.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-6 shadow-2xl shadow-black/40 backdrop-blur md:p-8">
      <form id="cf" method="POST" data-e="ZG90cy13aGlza3MuNnJAaWNsb3VkLmNvbQ==">
        <input type="hidden" name="_subject" value="New Lookout inquiry">
        <input type="hidden" name="_template" value="table">
        <input type="hidden" name="_captcha" value="false">
        <input type="hidden" name="_next" value="https://jsdosanj.github.io/lookout-site/contact?sent=1">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="sm:col-span-1">
            <label for="name" class="block text-sm font-semibold text-slate-200">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name"
              class="mt-2 block w-full rounded-xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-indigo-400/60 focus:ring-2 focus:ring-indigo-500/30"
              placeholder="Jane Doe">
          </div>
          <div class="sm:col-span-1">
            <label for="email" class="block text-sm font-semibold text-slate-200">Work email</label>
            <input id="email" name="email" type="email" required autocomplete="email"
              class="mt-2 block w-full rounded-xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-indigo-400/60 focus:ring-2 focus:ring-indigo-500/30"
              placeholder="jane@company.com">
          </div>
          <div class="sm:col-span-2">
            <label for="company" class="block text-sm font-semibold text-slate-200">Company <span class="font-normal text-slate-500">(optional)</span></label>
            <input id="company" name="company" type="text" autocomplete="organization"
              class="mt-2 block w-full rounded-xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-indigo-400/60 focus:ring-2 focus:ring-indigo-500/30"
              placeholder="Acme Inc.">
          </div>
          <div class="sm:col-span-2">
            <label for="message" class="block text-sm font-semibold text-slate-200">Message</label>
            <textarea id="message" name="message" rows="5" required
              class="mt-2 block w-full rounded-xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-indigo-400/60 focus:ring-2 focus:ring-indigo-500/30"
              placeholder="Tell us how many servers you're running and what you'd like to monitor…"></textarea>
          </div>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-4">
          <button type="submit"
            class="rounded-xl bg-gradient-to-r from-indigo-500 to-fuchsia-500 px-6 py-3 font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:opacity-90">
            Send message
          </button>
          <p class="text-sm text-slate-500">No spam — we'll only use your email to reply.</p>
        </div>
      </form>

      <div id="ok" hidden class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-8 text-center">
        <div class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-emerald-500/15 text-2xl text-emerald-400">◆</div>
        <h2 class="mt-4 text-xl font-bold text-white">Message sent.</h2>
        <p class="mt-2 text-slate-400">Thanks for reaching out — we'll get back to you shortly.</p>
        <a href={base} class="mt-6 inline-block font-semibold text-indigo-400 hover:text-indigo-300">← Back to home</a>
      </div>
    </div>

    <p class="mt-8 text-center text-sm text-slate-500">
      Prefer not to fill out the form? The fastest way to reach a human is right here — just send us a message above and we'll reply.
    </p>
  </section>

  <script is:inline>
   (function(){try{var f=document.getElementById('cf');f.action='https://formsubmit.co/'+atob(f.getAttribute('data-e'));}catch(e){}})();
   if(location.search.indexOf('sent=1')>=0){var o=document.getElementById('ok'),f=document.getElementById('cf');if(o)o.hidden=false;if(f)f.style.display='none';}
  </script>
</Base>
