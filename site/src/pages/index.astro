---
import Base from '../layouts/Base.astro';
import { DEMO_URL } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const title = 'Lookout — Simple Server & Infrastructure Monitoring';
const description =
  'Lookout is simple server and infrastructure monitoring built for humans. A lightweight agent reports each server in plain English with email/Slack alerts — an affordable Datadog and Nagios alternative.';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Lookout',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, Windows, macOS',
  description:
    'Lightweight server and infrastructure monitoring: one tiny agent per server reports OK/WARNING/CRITICAL health in plain English, with email, Slack, and webhook alerts. Nagios-plugin compatible.',
  url: 'https://dosanjhlabs.com/lookout/',
  image: 'https://dosanjhlabs.com/lookout/og-image.png',
  offers: {
    '@type': 'Offer',
    price: '14',
    priceCurrency: 'USD',
    description: 'Per server per month',
  },
  operatingSystemSupported: 'Linux, Windows, macOS',
  featureList: [
    'Plain-English server health (OK / WARNING / CRITICAL)',
    'Lightweight outbound-only monitoring agent',
    'Email, Slack, and webhook alerts',
    'Nagios-plugin compatible custom checks',
    'Managed or on-prem deployment',
  ],
};

const oses = ['Ubuntu', 'Debian', 'RHEL', 'Rocky', 'CentOS', 'AlmaLinux', 'Windows', 'macOS'];
const features = [
  { icon: '◆', title: 'One tiny agent', body: 'A single dependency-free binary on each server. Outbound-only — no open ports, no agents to babysit.' },
  { icon: '◆', title: 'Plain-English health', body: 'Every server reads ok / warning / critical with the reason spelled out — “disk /data is 94% full” — not a wall of metrics.' },
  { icon: '◆', title: 'Bring your own checks', body: 'Nagios-plugin compatible, plus drop-in custom plugins. The whole existing ecosystem works on day one.' },
  { icon: '◆', title: 'Built-in alerting', body: 'Rules per server and severity, delivered to Slack, Teams, or any webhook — with dedupe, flap-damping, escalation, and recovery notices, all set from the dashboard.' },
  { icon: '◆', title: 'Open source (Apache-2.0)', body: 'Self-host the whole thing for free, forever. Your infrastructure, your data. Or let us host it for you.' },
  { icon: '◆', title: 'Secure by design', body: 'Outbound-only agents, least privilege, no shell calls, constant-time auth — built to meet the standards it measures.' },
];
const steps = [
  { n: '1', title: 'Install the agent', body: 'One command per server. Linux, Windows, or macOS — same binary, no dependencies.' },
  { n: '2', title: 'It reports in', body: 'The agent securely sends specs, packages, and services to your dashboard on a schedule.' },
  { n: '3', title: 'See everything', body: 'Your whole fleet on one screen, color-coded, with the three things to fix first.' },
];
---

<Base title={title} description={description} jsonLd={softwareJsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden grid-texture">
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full bg-gradient-to-br from-indigo-600/30 via-fuchsia-600/20 to-cyan-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 md:pt-28">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-indigo-300">● Managed & on-prem monitoring</span>
        <h1 class="mt-6 text-balance text-4xl font-black leading-tight tracking-tight text-white md:text-6xl">
          Know your servers are healthy — <span class="bg-gradient-to-r from-indigo-400 via-fuchsia-400 to-cyan-300 bg-clip-text text-transparent">before they’re not.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg text-slate-300">
          Lookout is open-source infrastructure monitoring built for humans. Drop a tiny agent on any server, get a
          plain-English health dashboard for your whole fleet, and get warned in Slack or Teams before it breaks.
          <span class="text-white">Self-host it free, managed by us, or deployed on-prem.</span>
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={`${base}pricing/`} class="rounded-xl bg-gradient-to-r from-indigo-500 to-fuchsia-500 px-6 py-3 font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:opacity-90">See pricing →</a>
          <a href={DEMO_URL} class="rounded-xl border border-white/15 bg-white/5 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Explore the demo</a>
        </div>
        <p class="mt-4 text-sm text-slate-400">Ubuntu · Debian · RHEL · Rocky · Windows · macOS — one agent, every platform.</p>
      </div>

      <div class="mx-auto mt-16 max-w-4xl rounded-2xl border border-white/10 bg-slate-900/70 p-4 shadow-2xl shadow-black/40 backdrop-blur">
        <div class="mb-3 flex items-center gap-2 px-2">
          <span class="h-3 w-3 rounded-full bg-red-400/80"></span><span class="h-3 w-3 rounded-full bg-amber-400/80"></span><span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
          <span class="ml-3 text-xs text-slate-400">lookout · 5 servers</span>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-xl border border-white/10 bg-slate-950/60 p-4">
            <div class="flex items-center justify-between"><span class="font-semibold text-white">web-01</span><span class="rounded-full bg-emerald-500/15 px-2 py-0.5 text-xs font-bold text-emerald-400">OK</span></div>
            <div class="mt-3 h-1.5 rounded bg-slate-800"><div class="h-1.5 w-[42%] rounded bg-indigo-400"></div></div>
            <p class="mt-2 text-xs text-slate-400">mem 42% · disk 61%</p>
          </div>
          <div class="rounded-xl border border-amber-500/20 bg-slate-950/60 p-4">
            <div class="flex items-center justify-between"><span class="font-semibold text-white">app-02</span><span class="rounded-full bg-amber-500/15 px-2 py-0.5 text-xs font-bold text-amber-400">WARN</span></div>
            <div class="mt-3 h-1.5 rounded bg-slate-800"><div class="h-1.5 w-[92%] rounded bg-amber-400"></div></div>
            <p class="mt-2 text-xs text-amber-400/90">memory 92% used</p>
          </div>
          <div class="rounded-xl border border-red-500/20 bg-slate-950/60 p-4">
            <div class="flex items-center justify-between"><span class="font-semibold text-white">db-01</span><span class="rounded-full bg-red-500/15 px-2 py-0.5 text-xs font-bold text-red-400">CRIT</span></div>
            <div class="mt-3 h-1.5 rounded bg-slate-800"><div class="h-1.5 w-[94%] rounded bg-red-400"></div></div>
            <p class="mt-2 text-xs text-red-400/90">disk /data is 94% full</p>
          </div>
          <div class="rounded-xl border border-slate-500/20 bg-slate-950/60 p-4">
            <div class="flex items-center justify-between"><span class="font-semibold text-white">app-03</span><span class="rounded-full bg-slate-500/20 px-2 py-0.5 text-xs font-bold text-slate-300">STALE</span></div>
            <div class="mt-3 h-1.5 rounded bg-slate-800"><div class="h-1.5 w-[12%] rounded bg-slate-500"></div></div>
            <p class="mt-2 text-xs text-slate-400">no report for 8 min</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OS strip -->
  <section class="border-y border-white/5 bg-white/[0.02]">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-6 py-7 text-sm font-bold uppercase tracking-wider text-slate-500">
      {oses.map((os) => <span>{os}</span>)}
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-black tracking-tight text-white md:text-4xl">Monitoring that explains itself.</h2>
      <p class="mt-4 text-lg text-slate-400">Everything you need to know your fleet is healthy — and nothing you don’t.</p>
    </div>
    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="group rounded-2xl border border-white/10 bg-slate-900/40 p-6 transition hover:border-indigo-400/40 hover:bg-slate-900/70">
          <div class="grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br from-indigo-500/20 to-fuchsia-500/20 text-xl text-indigo-300">{f.icon}</div>
          <h3 class="mt-5 text-lg font-bold text-white">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.body}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center"><a href={`${base}why/`} class="font-semibold text-indigo-400 hover:text-indigo-300">See the problem Lookout solves →</a></div>
  </section>

  <!-- How it works -->
  <section class="border-y border-white/5 bg-white/[0.02]">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-black tracking-tight text-white md:text-4xl">Live in three steps.</h2>
        <p class="mt-4 text-lg text-slate-400">If you can copy a line into a terminal, you can run Lookout.</p>
      </div>
      <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-3">
        {steps.map((s) => (
          <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-7">
            <div class="grid h-10 w-10 place-items-center rounded-full bg-gradient-to-br from-indigo-500 to-fuchsia-500 font-bold text-white">{s.n}</div>
            <h3 class="mt-5 text-lg font-bold text-white">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center"><a href={`${base}docs/getting-started/`} class="font-semibold text-indigo-400 hover:text-indigo-300">Read the getting-started guide →</a></div>
    </div>
  </section>

  <!-- Alerting -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">Built-in alerting</span>
        <h2 class="mt-4 text-3xl font-black tracking-tight text-white md:text-4xl">Warn before it breaks — in the channel you already watch.</h2>
        <p class="mt-4 text-lg text-slate-400">Monitoring only helps if it tells you in time. Lookout turns a host's health into one clear message in Slack, Teams, or any webhook — and stays quiet otherwise.</p>
        <ul class="mt-8 space-y-4">
          <li class="flex gap-3"><span class="mt-1 text-indigo-400">→</span><span class="text-slate-300"><strong class="text-white">Rules from the dashboard.</strong> Set which servers and what severity (warning / critical / silent) should page, and where it goes. No config files to edit.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-indigo-400">→</span><span class="text-slate-300"><strong class="text-white">One alert per problem.</strong> Dedupe and flap-damping mean a noisy disk doesn't page you every minute. Escalation reminders nudge until it's handled; a recovery notice tells you when it clears.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-indigo-400">→</span><span class="text-slate-300"><strong class="text-white">Catch the silent ones.</strong> A host that stops reporting can't alert on its own — so Lookout sweeps the fleet every minute and pages you when a server goes quiet.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-indigo-400">→</span><span class="text-slate-300"><strong class="text-white">Acknowledge or snooze.</strong> Say "I'm on it" to stop the reminders without waiting for recovery — and an escalation still re-alerts if it gets worse.</span></li>
        </ul>
        <p class="mt-6 text-sm text-slate-500">Webhook delivery (Slack / Teams / generic) is live and self-contained. Email is delivered through our hosted notification service. Every outbound URL is checked against an SSRF guard before any request is sent.</p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-5 shadow-2xl shadow-black/40">
        <div class="mb-4 flex items-center gap-2 px-1">
          <span class="grid h-6 w-6 place-items-center rounded bg-gradient-to-br from-indigo-500 to-fuchsia-500 text-xs">#</span>
          <span class="text-sm font-semibold text-white">#ops-alerts</span>
        </div>
        <div class="space-y-3 text-sm">
          <div class="rounded-xl border border-amber-500/20 bg-slate-950/60 p-3 text-slate-200">🟠 <strong class="text-white">Lookout:</strong> app-02 is warning — memory 92% used</div>
          <div class="rounded-xl border border-red-500/20 bg-slate-950/60 p-3 text-slate-200">🔴 <strong class="text-white">Lookout:</strong> db-01 is critical — disk /data is 94% full</div>
          <div class="rounded-xl border border-slate-500/20 bg-slate-950/60 p-3 text-slate-200">⚪ <strong class="text-white">Lookout:</strong> app-03 is stale</div>
          <div class="rounded-xl border border-emerald-500/20 bg-slate-950/60 p-3 text-slate-200">✅ <strong class="text-white">Lookout:</strong> app-02 recovered (was warning)</div>
        </div>
      </div>
    </div>
    <div class="mt-10 text-center"><a href={`${base}docs/alerts/`} class="font-semibold text-indigo-400 hover:text-indigo-300">How alerting works →</a></div>
  </section>

  <!-- Audience -->
  <section class="border-y border-white/5 bg-white/[0.02]">
    <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-indigo-500/10 to-transparent p-8">
        <h3 class="text-xl font-bold text-white">For everyone</h3>
        <p class="mt-3 text-slate-400">No security degree required. Lookout tells you, in plain English, whether your servers are OK and what to fix first — perfect for owners, office managers, and one-person IT.</p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-cyan-500/10 to-transparent p-8">
        <h3 class="text-xl font-bold text-white">For engineers</h3>
        <p class="mt-3 text-slate-400">Nagios-compatible plugins, an API, custom checks, dashboard-driven alert rules, and CI/CD gates. Self-host the whole stack on-prem inside your own network and own your data. Apache-2.0.</p>
      </div>
    </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-indigo-600 via-violet-600 to-fuchsia-600 px-8 py-16 text-center shadow-2xl shadow-indigo-500/20">
      <h2 class="text-3xl font-black tracking-tight text-white md:text-4xl">Stop guessing whether your servers are OK.</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-indigo-100">See pricing, explore the demo, or read the getting-started guide.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={`${base}pricing/`} class="rounded-xl bg-white px-6 py-3 font-semibold text-slate-900 transition hover:bg-slate-100">See pricing</a>
        <a href={DEMO_URL} class="rounded-xl border border-white/30 bg-white/10 px-6 py-3 font-semibold text-white transition hover:bg-white/20">Demo</a>
        <a href={`${base}docs/`} class="rounded-xl border border-white/30 bg-white/10 px-6 py-3 font-semibold text-white transition hover:bg-white/20">Docs</a>
      </div>
    </div>
  </section>
</Base>
